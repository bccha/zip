[core]
	autocrlf = true
	editor = code --wait

[user]
	name = Byung Chang Cha
	email = jeffchabc@gmail.com

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	up = pull --rebase
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
